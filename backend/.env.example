# Turso/libSQL: use a local file URL only for development.
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# Required outside local development. Generate a high-entropy value.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=seshadripuram-one-api
JWT_AUDIENCE=seshadripuram-one-app

# console is local-only; use resend only after configuring the variables below.
OTP_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=
NODE_ENV=development
PORT=3000
# Comma-separated browser origins. Native mobile apps do not send an Origin.
CORS_ORIGINS=http://localhost:3000

# Default false is safe for direct connections. Set an exact hop count/address
# only when the API is reachable exclusively through that trusted reverse proxy.
TRUST_PROXY=false
IMPORT_PAYLOAD_RETENTION_DAYS=7

# Optional SMTP alternative to Resend; use a college-approved sender/account.
# OTP_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=false
